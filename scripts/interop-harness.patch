+		t.Fatal(err)
+	}
+	client := &tailcat.Client{Server: tailcat.Addr(addr), DERPMapURL: srv.URL + "/derpmap.json", Logf: mkLogf(t, "client")}
+	defer client.Close()
+	first, err := client.DialTCPPort(runCtx, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	first.SetDeadline(time.Now().Add(10 * time.Second))
+	io.WriteString(first, "first")
+	first.(interface{ CloseWrite() error }).CloseWrite()
+	if _, err := io.Copy(io.Discard, first); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.DrainTCP(runCtx); err != nil {
+		t.Fatal(err)
+	}
+	second, err := client.DialTCPPort(runCtx, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.Close()
+	second.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := io.WriteString(second, "second"); err != nil {
+		t.Fatal(err)
+	}
+	if err := chromedp.Run(runCtx,
+		chromedp.Poll("staleTest.connections.length === 2", &ready),
+		chromedp.Evaluate(`(async () => {
+		  const old = staleTest.connections[0];
+		  old.close();
+		  await old.closeWrite();
+		  if (await old.read() !== null) throw new Error('old connection read the new stream');
+		  let rejected = false;
+		  try { await old.write(Uint8Array.of(1)); } catch (_) { rejected = true; }
+		  if (!rejected) throw new Error('old connection wrote to the new stream');
+		  staleTest.staleDone = true;
+		  const conn = staleTest.connections[1];
+		  let text = '';
+		  for (let chunk; (chunk = await conn.read()) !== null;) text += new TextDecoder().decode(chunk);
+		  if (text !== 'second') throw new Error('new stream was corrupted: ' + text);
+		  conn.close();
+		  staleTest.secondDone = true;
+		})().catch(e => tcTest.errors.push(String(e)));`, nil),
+		chromedp.Poll("staleTest.staleDone || tcTest.errors.length > 0", &ready),
+	); err != nil {
+		t.Fatal(err)
+	}
+	checkPageErrors(t, runCtx)
+	second.(interface{ CloseWrite() error }).CloseWrite()
+	if _, err := io.Copy(io.Discard, second); err != nil {
+		t.Fatal(err)
+	}
+	if err := chromedp.Run(runCtx,
+		chromedp.Poll("staleTest.secondDone", &ready),
+		chromedp.Evaluate("staleTest.closeOnReconnect = true; staleTest.websockets[0].close();", nil),
+		chromedp.Poll("staleTest.websockets.length > 1 && staleTest.websockets.every(ws => ws.readyState === WebSocket.CLOSED)", &ready,
+			chromedp.WithPollingTimeout(15*time.Second)),
+	); err != nil {
+		t.Fatal(err)
+	}
+	checkPageErrors(t, runCtx)
+}
