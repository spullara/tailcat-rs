+
+func TestRustInteropPerf(t *testing.T) {
+ if os.Getenv("TAILCAT_TEST_BINARY") == "" { t.Skip("requires Rust binary override") }
+ e := newTestEnv(t)
+ dm, err := tailcat.FetchDERPMap(t.Context(), tailcat.DERPMapURL(e.derpMapURL)); if err != nil { t.Fatal(err) }
+ t.Run("GoClientRustServer",func(t *testing.T) {
+  _,addr,_ := e.startServer("serve","perf")
+  client := &tailcat.Client{Server:tailcat.Addr(addr),DERPMapURL:e.derpMapURL}; defer client.Close()
+  pc := &perf.Client{DialTCP:func(ctx context.Context)(net.Conn,error){return client.DialTCPPort(ctx,perf.Port)},DialUDP:func(ctx context.Context)(net.Conn,error){return client.DialUDPPort(ctx,perf.Port)}}
+  for _,proto := range []perf.Proto{perf.TCP,perf.UDP} { for _,dir := range []perf.Direction{perf.Upload,perf.Download,perf.Bidirectional} {
+   t.Run(string(proto)+"/"+string(dir),func(t *testing.T){ ctx,cancel:=context.WithTimeout(t.Context(),30*time.Second); defer cancel()
+    res,err:=pc.Run(ctx,perf.Params{Proto:proto,Direction:dir,Bytes:12000,Streams:2,Length:1200,Bitrate:1000000}); if err!=nil {t.Fatal(err)}
+    if dir!=perf.Download && (res.ClientSent.Bytes!=24000 || res.ServerReceived.Bytes!=24000) {t.Fatalf("upload mismatch: %+v",res)}
+    if dir!=perf.Upload && (res.ServerSent.Bytes!=24000 || res.ClientReceived.Bytes!=24000) {t.Fatalf("download mismatch: %+v",res)}
+    time.Sleep(50*time.Millisecond)
+   })
+  } }
+ })
+ t.Run("RustClientGoServer",func(t *testing.T) {
+  ps:=new(perf.Server)
+  server:=&tailcat.Server{Region:dm.Regions[1]}; defer server.Close()
+  server.OnTCP=func(port uint16)func(net.Conn){if port==perf.Port{return ps.HandleTCP};return nil}
+  server.OnUDP=func(port uint16)func(tailcat.ConnPacketConn){if port==perf.Port{return func(c tailcat.ConnPacketConn){ps.HandleUDP(c)}};return nil}
+  if err:=server.Start();err!=nil{t.Fatal(err)}
+  for _,proto:=range []string{"tcp","udp"}{for _,dir:=range []string{"up","down","both"}{t.Run(proto+"/"+dir,func(t *testing.T){
+   args:=[]string{"--key=new","--derpmap-url="+e.derpMapURL,"--json","perf","--bytes=12000","--parallel=2","--length=1200","--bitrate=1M","--interval=0","--via-derp"}
+   if proto=="udp"{args=append(args,"--udp")};if dir=="down"{args=append(args,"--reverse")};if dir=="both"{args=append(args,"--bidir")};args=append(args,string(server.TailcatAddr()))
+   cmd:=e.cmd(args...); out,err:=cmd.Output();if err!=nil{t.Fatalf("client: %v",err)}
+   var res perf.Result;if err:=json.Unmarshal(out,&res);err!=nil{t.Fatalf("%v: %s",err,out)}
+   if dir!="down" && (res.ClientSent==nil || res.ServerReceived==nil || res.ClientSent.Bytes!=24000 || res.ServerReceived.Bytes!=24000){t.Fatalf("upload mismatch: %s",out)}
+   if dir!="up" && (res.ServerSent==nil || res.ClientReceived==nil || res.ServerSent.Bytes!=24000 || res.ClientReceived.Bytes!=24000){t.Fatalf("download mismatch: %s",out)}
+  })}}
+ })
+}
