+		const NativeWebSocket = globalThis.WebSocket;
+		globalThis.WebSocket = class extends NativeWebSocket {
+		  constructor(...args) {
+		    super(...args);
+		    staleTest.websockets.push(this);
+		    if (staleTest.closeOnReconnect) queueMicrotask(() => staleTest.listener.close());
+		  }
+		};
+		tailcatListen({derpMapURL: new URL('/derpmap.json', location.href).href,
+		  onConnection(conn) {
+		    staleTest.connections.push(conn);
+		    if (staleTest.connections.length === 1) (async () => {
+		      while ((await conn.read()) !== null) {}
+		      conn.close();
+		      staleTest.firstDone = true;
+		    })().catch(e => tcTest.errors.push(String(e)));
+		  }
