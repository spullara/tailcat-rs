@@ -0,0 +1,227 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package main
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/tailscale/tailcat"
+)
+
+// TestRustInteropBinaries launches the actual Go and Rust executables. It
+// complements TestRustInterop's Go-library oracle with the complete CLI paths.
+func TestRustInteropBinaries(t *testing.T) {
+	if os.Getenv("TAILCAT_TEST_BINARY") == "" {
+		t.Skip("requires Rust binary override")
+	}
+	e := newTestEnv(t)
+	goBin := buildGoTailcat(t) // Deliberately bypass TAILCAT_TEST_BINARY.
+	for _, pair := range []struct {
+		name, client, server string
+	}{
+		{"RustClientGoServer", e.bin, goBin},
+		{"GoClientRustServer", goBin, e.bin},
+	} {
+		t.Run(pair.name, func(t *testing.T) {
+			command := func(bin string, relayOnly bool, args ...string) *exec.Cmd {
+				cmd := exec.Command(bin, append([]string{"--key=new", "--derpmap-url=" + e.derpMapURL}, args...)...)
+				cmd.Env = append(append([]string{}, e.env...),
+					"TS_DEBUG_TAILCAT_LOCAL_DERP=0",
+					"TS_DEBUG_ALWAYS_USE_DERP=0",
+					"TS_DEBUG_NEVER_DIRECT_UDP=0")
+				if relayOnly && bin == goBin {
+					// This upstream knob prevents Go from opening either UDP socket,
+					// making a successful exchange proof of relay-only transport.
+					cmd.Env = append(cmd.Env, "TS_DEBUG_ALWAYS_USE_DERP=1")
+				}
+				return cmd
+			}
+			for _, relayOnly := range []bool{false, true} {
+				name := "AutoPipe"
+				if relayOnly {
+					name = "RelayOnlyPipe"
+				}
+				t.Run(name, func(t *testing.T) {
+					request, response := interopPayload(0x35), interopPayload(0xa7)
+					port, exchange := startInteropExchange(t, request, response)
+					addrFile := filepath.Join(t.TempDir(), "addr")
+					serverCmd := command(pair.server, relayOnly, "serve", strconv.Itoa(int(port)))
+					serverCmd.Env = append(serverCmd.Env, "TAILCAT_ADDR_FILE="+addrFile)
+					server := startInteropProcess(t, serverCmd)
+					addr := server.address(t, addrFile)
+					clientCmd := command(pair.client, relayOnly, addr, strconv.Itoa(int(port)))
+					clientCmd.Stdin = bytes.NewReader(request)
+					client := startInteropProcess(t, clientCmd)
+					client.wait(t)
+					if err := <-exchange; err != nil {
+						t.Fatalf("application exchange: %v\nserver stderr:\n%s", err, server.stderr())
+					}
+					if !bytes.Equal(client.stdout.Bytes(), response) {
+						t.Fatalf("client received %d bytes; want %d exact bytes\nclient stderr:\n%s\nserver stderr:\n%s",
+							client.stdout.Len(), len(response), client.stderr(), server.stderr())
+					}
+					t.Logf("verified %d request bytes and %d response bytes; response completed after request EOF", len(request), len(response))
+				})
+			}
+			t.Run("DirectDiscovery", func(t *testing.T) {
+				addrFile := filepath.Join(t.TempDir(), "addr")
+				serverCmd := command(pair.server, false)
+				serverCmd.Env = append(serverCmd.Env, "TAILCAT_ADDR_FILE="+addrFile)
+				server := startInteropProcess(t, serverCmd)
+				addr := server.address(t, addrFile)
+				client := startInteropProcess(t, command(pair.client, false, "ping", "--until-direct", "--timeout=20s", addr))
+				client.wait(t)
+				lines := strings.Split(strings.TrimSpace(client.stdout.String()), "\n")
+				last := lines[len(lines)-1]
+				_, endpoint, ok := strings.Cut(last, " via ")
+				if !strings.HasPrefix(last, "pong in ") || !ok {
+					t.Fatalf("missing direct pong: %q", client.stdout.String())
+				}
+				if _, err := netip.ParseAddrPort(endpoint); err != nil {
+					t.Fatalf("pong did not use a direct UDP endpoint: %q", last)
+				}
+				t.Log(last)
+			})
+		})
+	}
+}
+
+func interopPayload(seed byte) []byte {
+	b := make([]byte, 2<<20)
+	for i := range b {
+		b[i] = byte(i*37+i/256) ^ seed
+	}
+	return b
+}
+
+// Send an initial reply before consuming the request, then wait for request
+// EOF before sending the remainder. This exercises bidirectional transfer and
+// preserves the client's ability to receive after closing its write half.
+func startInteropExchange(t *testing.T, request, response []byte) (uint16, <-chan error) {
+	t.Helper()
+	ln, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+	t.Cleanup(func() { cancel(); ln.Close() })
+	deadline, _ := ctx.Deadline()
+	if err := ln.SetDeadline(deadline); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		done <- func() error {
+			conn, err := ln.AcceptTCP()
+			if err != nil {
+				return err
+			}
+			defer conn.Close()
+			stop := context.AfterFunc(ctx, func() { conn.Close() })
+			defer stop()
+			if err := conn.SetDeadline(deadline); err != nil {
+				return err
+			}
+			const prefix = 64 << 10
+			if _, err := conn.Write(response[:prefix]); err != nil {
+				return err
+			}
+			got, err := io.ReadAll(conn)
+			if err != nil {
+				return err
+			}
+			if !bytes.Equal(got, request) {
+				return fmt.Errorf("application received %d bytes; want %d exact bytes", len(got), len(request))
+			}
+			if _, err := conn.Write(response[prefix:]); err != nil {
+				return err
+			}
+			return conn.CloseWrite()
+		}()
+	}()
+	return uint16(ln.Addr().(*net.TCPAddr).Port), done
+}
+
+// File-backed stderr can safely be inspected while a process is still running.
+// stdout is read only after Wait completes, and every child is killed/reaped on
+// timeout or test failure, including long-running serve commands.
+type interopProcess struct {
+	done       chan struct{}
+	err        error
+	stdout     bytes.Buffer
+	stderrPath string
+}
+
+func startInteropProcess(t *testing.T, command *exec.Cmd) *interopProcess {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+	p := &interopProcess{done: make(chan struct{}), stderrPath: filepath.Join(t.TempDir(), "stderr")}
+	stderr, err := os.Create(p.stderrPath)
+	if err != nil {
+		cancel()
+		t.Fatal(err)
+	}
+	cmd := exec.CommandContext(ctx, command.Path, command.Args[1:]...)
+	cmd.Env, cmd.Dir, cmd.Stdin = command.Env, command.Dir, command.Stdin
+	cmd.Stdout, cmd.Stderr, cmd.WaitDelay = &p.stdout, stderr, 2*time.Second
+	if err := cmd.Start(); err != nil {
+		cancel()
+		stderr.Close()
+		t.Fatal(err)
+	}
+	go func() { p.err = cmd.Wait(); close(p.done) }()
+	t.Cleanup(func() {
+		cancel()
+		<-p.done
+		stderr.Close()
+		if t.Failed() {
+			t.Logf("%s stderr:\n%s", cmd.Path, p.stderr())
+		}
+	})
+	return p
+}
+
+func (p *interopProcess) stderr() string {
+	b, _ := os.ReadFile(p.stderrPath)
+	return string(b)
+}
+
+func (p *interopProcess) wait(t *testing.T) {
+	t.Helper()
+	<-p.done
+	if p.err != nil {
+		t.Fatalf("tailcat exited with %v\nstderr:\n%s", p.err, p.stderr())
+	}
+}
+
+func (p *interopProcess) address(t *testing.T, path string) string {
+	t.Helper()
+	ticker := time.NewTicker(20 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if b, err := os.ReadFile(path); err == nil && len(b) > 0 {
+			addr := strings.TrimSpace(string(b))
+			if _, err := tailcat.ParseAddr(tailcat.Addr(addr)); err == nil {
+				return addr
+			}
+		}
+		select {
+		case <-p.done:
+			t.Fatalf("server exited before publishing address: %v\nstderr:\n%s", p.err, p.stderr())
+		case <-ticker.C:
+		}
+	}
+}
