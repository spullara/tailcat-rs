+)
+
+// These tests intentionally keep the Go implementation as an independent
+// protocol oracle. Enable them with TAILCAT_TEST_BINARY=/absolute/rust/tailcat.
+func TestRustInterop(t *testing.T) {
+	if os.Getenv("TAILCAT_TEST_BINARY") == "" {
+		t.Skip("requires Rust binary override")
+	}
+	e := newTestEnv(t)
+	dm, err := tailcat.FetchDERPMap(t.Context(), tailcat.DERPMapURL(e.derpMapURL))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var reg = dm.Regions[1]
+	if reg == nil {
+		t.Fatal("missing local region")
+	}
+	t.Run("RustClientGoServer", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+		defer cancel()
+		deadline, _ := ctx.Deadline()
+		serverDone := make(chan error, 1)
+		s := &tailcat.Server{Region: reg, Logf: t.Logf}
+		s.OnTCP = func(port uint16) func(net.Conn) {
+			return func(c net.Conn) {
+				defer c.Close()
+				if err := c.SetDeadline(deadline); err != nil {
+					serverDone <- err
+					return
+				}
+				// Respond only after EOF: catches premature full-close instead of FIN.
+				data, err := io.ReadAll(c)
+				if err == nil {
+					_, err = c.Write(data)
+				}
+				serverDone <- err
+			}
+		}
+		if err := s.Start(); err != nil {
+			t.Fatal(err)
+		}
+		defer s.Close()
+		payload := strings.Repeat("WireGuard Go to Rust half-close\x00\xff", 65536)
+		got, err := runClient(t, e.cmd("--key=new", string(s.TailcatAddr())), nil, payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case err := <-serverDone:
+			if err != nil {
+				t.Fatalf("Go server transfer: %v", err)
+			}
+		case <-ctx.Done():
+			t.Fatalf("Go server transfer did not finish: %v", ctx.Err())
+		}
+		if got != payload {
+			t.Fatalf("round-trip mismatch: received %d of %d bytes", len(got), len(payload))
+		}
+	})
+	t.Run("GoClientRustServer", func(t *testing.T) {
+		port := startEchoListener(t)
+		_, addr, stderr := e.startServer("serve", strconv.Itoa(int(port)))
+		c := &tailcat.Client{Server: tailcat.Addr(addr), DERPMapURL: e.derpMapURL, Logf: t.Logf}
+		defer c.Close()
+		ctx, cancel := context.WithTimeout(t.Context(), 45*time.Second)
+		defer cancel()
+		conn, err := c.DialTCPPort(ctx, port)
+		if err != nil {
+			t.Fatalf("dial: %v\n%s", err, stderr.String())
+		}
+		defer conn.Close()
+		deadline, _ := ctx.Deadline()
+		if err := conn.SetDeadline(deadline); err != nil {
+			t.Fatal(err)
+		}
+		payload := bytes.Repeat([]byte("Rust server interoperability\x00\xff"), 65536)
+		writeDone := make(chan error, 1)
+		go func() {
+			_, err := conn.Write(payload)
+			if err == nil {
+				err = conn.(interface{ CloseWrite() error }).CloseWrite()
+			}
+			writeDone <- err
+		}()
+		got, err := io.ReadAll(conn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := <-writeDone; err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, payload) {
+			t.Fatalf("round-trip mismatch: received %d of %d bytes", len(got), len(payload))
+		}
+		if err := c.DrainTCP(ctx); err != nil {
+			t.Fatal(err)
+		}
+	})
+}
